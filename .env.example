# Network — public mainnet RPCs (no API key required)
GAS_BOT__NETWORK__CHAIN_ID=1
GAS_BOT__NETWORK__RPC_URLS='["https://ethereum.publicnode.com","https://eth.llamarpc.com","https://1rpc.io/eth"]'

# Gas limits
GAS_BOT__GAS__MAX_GAS_PRICE_GWEI=500.0
GAS_BOT__GAS__MIN_GAS_PRICE_GWEI=1.0
GAS_BOT__GAS__REPLACEMENT_BUMP_PERCENT=15.0

# Profit thresholds
GAS_BOT__PROFIT__MIN_PROFIT_PERCENT=15.0
GAS_BOT__PROFIT__MIN_TX_VALUE_ETH=0.1

# Safety
GAS_BOT__SAFETY__CIRCUIT_BREAKER_ENABLED=true
GAS_BOT__SAFETY__MAX_CONSECUTIVE_FAILURES=5
GAS_BOT__SAFETY__MAX_DAILY_SPEND_ETH=1.0
GAS_BOT__SAFETY__EMERGENCY_STOP=false

# Logging
GAS_BOT__LOGGING__LEVEL=info
GAS_BOT__LOGGING__LOG_FILE=logs/gas-auction-bot.log
GAS_BOT__LOGGING__JSON_LOG_ENABLED=true

# Analysis
GAS_BOT__ANALYSIS__SLIPPAGE_BPS=50
GAS_BOT__ANALYSIS__MAX_RISK_SCORE=70
GAS_BOT__ANALYSIS__BASE_LIQUIDITY_ETH=100.0
GAS_BOT__ANALYSIS__MAX_QUEUE_SIZE=256

# Execution
GAS_BOT__EXECUTION__CONFIRMATION_TIMEOUT_SECS=60
GAS_BOT__EXECUTION__REPLACEMENT_POLL_INTERVAL_SECS=5
GAS_BOT__EXECUTION__SOFT_GAS_CAP_RATIO=0.8

# Server
GAS_BOT__SERVER__BIND_ADDRESS=0.0.0.0:9090
GAS_BOT__SERVER__WORKER_COUNT=8
GAS_BOT__SERVER__NETWORK_CACHE_TTL_SECS=12
GAS_BOT__SERVER__SHUTDOWN_DRAIN_SECS=10

# Wallet — leave empty for analysis-only mode
GAS_BOT__WALLET__PRIVATE_KEY=
